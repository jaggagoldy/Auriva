# Auriva — environment configuration example.
# Copy to `.env` (or set in your host's env) and fill in real values.
# Startup validation (src/lib/config.ts) fails fast if production config is
# invalid, so a misconfigured deploy never starts serving silently.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# One of: development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (Release 1.2 Batch 4 / B1) — always required
# ---------------------------------------------------------------------------
# PostgreSQL connection string. No default — the app will not start without it.
DATABASE_URL="postgresql://user:password@localhost:5432/auriva?schema=public"

# ---------------------------------------------------------------------------
# SMS / OTP delivery (H1 / SEC-3)
# ---------------------------------------------------------------------------
# Selects the OTP SMS provider. Pluggable, no vendor lock-in — switching
# providers is a config change, never a code change.
#
#   SMS_PROVIDER = twilio | msg91 | exotel | log
#
# In DEVELOPMENT/TEST you may leave this unset (or use "log"): no SMS is sent
# and the code is echoed on-screen / in logs for testing.
# In PRODUCTION a real provider is REQUIRED and must be fully configured, or
# the server refuses to start (OTP delivery is the pilot gate).
SMS_PROVIDER=log

# --- Twilio (SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=            # an SMS-capable Twilio number in E.164, e.g. +14155550123

# --- MSG91 (SMS_PROVIDER=msg91) — India DLT-compliant OTP ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=     # a DLT-approved OTP template id (sender id is set in the template)

# --- Exotel (SMS_PROVIDER=exotel) ---
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_FROM=           # an approved Exotel sender id
# EXOTEL_SUBDOMAIN=api.exotel.com   # optional; defaults to api.exotel.com

# ---------------------------------------------------------------------------
# Operational alerting (RG-001) — REQUIRED in production
# ---------------------------------------------------------------------------
# Where production failure alerts (DB-unreachable, crash, 5xx-rate spike) are
# delivered. Pluggable, webhook-based, no vendor lock-in.
#
#   ALERT_CHANNEL = slack | discord | webhook | log
#
# In PRODUCTION a real channel is REQUIRED (the server refuses to start without
# one — operational alerting is a Code-Freeze criterion). "log" is dev/test only.
ALERT_CHANNEL=log
# The incoming-webhook URL for the selected channel (Slack/Discord/generic).
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Demo mode (H2) — optional kill-switch
# ---------------------------------------------------------------------------
# DEMO_MODE_ENABLED=false   # disables "Skip & explore" + demo endpoints (default on)
